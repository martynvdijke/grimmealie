{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:allNonMajor"
  ],
  "automergeType": "pr",
  "dependencyDashboard": true,
  "ignorePaths": [
    "test/**"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "platform": "github",
  "platformAutomerge": true,
  "prCreation": "immediate",
  "prHourlyLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "configMigration": true,
  "repositories": [
    "martynvdijke/grimmealie"
  ],
  "timezone": "UTC+1",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "github-actions": {
    "enabled": true
  },
  "pep621": {
    "enabled": true
  },
  "stalePr": true,
  "stalePrAge": 7
}
